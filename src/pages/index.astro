---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import ConstructionNotice from '../components/ConstructionNotice.astro';
import { withBase } from '../lib/urls';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const journal = (await getCollection('journal'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Language · evidence · implementation</p>
        <h1>Finding the architecture hidden inside software systems.</h1>
        <p class="hero-copy">
          A public engineering notebook about how designing a constructed language changed the
          way I think about meaning, ownership, evidence, and long-lived projects.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={withBase('/ideas/')}>Explore the ideas</a>
          <a class="button secondary" href={withBase('/projects/')}>See the projects</a>
        </div>
      </div>
      <aside class="thesis-card">
        <p class="eyebrow">Working thesis</p>
        <blockquote>
          Projects are evidence. The recurring story is the method: let language make categories
          visible, let implementation challenge theory, and let architecture learn.
        </blockquote>
      </aside>
    </div>
  </section>

  <section class="section-shell origin-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The origin</p>
        <h2>The conlang came first.</h2>
      </div>
      <p>
        Tonesu began as a language project. Its pressure toward explicit categories,
        composition, scope, and corpus evidence gradually reshaped how the later software
        projects were designed.
      </p>
    </div>
    <ConstructionNotice compact />
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Living evidence</p>
        <h2>Five projects, one evolving method.</h2>
      </div>
      <a class="text-link" href={withBase('/projects/')}>All projects →</a>
    </div>
    <div class="card-grid project-grid">
      {
        projects.map((project) => (
          <EntryCard
            href={withBase(`/projects/${project.id}/`)}
            eyebrow={project.data.origin}
            title={project.data.title}
            summary={project.data.summary}
            meta={project.data.status}
          />
        ))
      }
    </div>
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Journal</p>
        <h2>Recent notes and discoveries.</h2>
      </div>
      <a class="text-link" href={withBase('/journal/')}>Open the journal →</a>
    </div>
    <div class="card-grid">
      {
        journal.map((entry) => (
          <EntryCard
            href={withBase(`/journal/${entry.id}/`)}
            eyebrow={entry.data.kind.replace('-', ' ')}
            title={entry.data.title}
            summary={entry.data.description}
            meta={entry.data.published.toLocaleDateString('en-US', { dateStyle: 'medium' })}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
