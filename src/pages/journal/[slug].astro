---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => data.status !== 'draft');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.kind.replace('-', ' ')}
  status={entry.data.status}
  tags={entry.data.tags}
  projects={entry.data.projects}
  date={entry.data.published}
  underConstruction={entry.data.underConstruction}
>
  <Content />
</ContentLayout>
