---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import ConstructionNotice from '../../components/ConstructionNotice.astro';
import { withBase } from '../../lib/urls';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Living evidence for an evolving architectural method.">
  <section class="listing-hero section-shell">
    <p class="eyebrow">Living evidence</p>
    <h1>Projects</h1>
    <p class="lede">
      These are not isolated portfolio pieces. Each project tests the same questions in a
      different domain: who owns meaning, what counts as evidence, and which boundaries must be
      structural?
    </p>
    <ConstructionNotice compact />
  </section>
  <section class="section-shell">
    <div class="card-grid project-grid">
      {
        projects.map((project) => (
          <EntryCard
            href={withBase(`/projects/${project.id}/`)}
            eyebrow={project.data.origin}
            title={project.data.title}
            summary={project.data.summary}
            meta={`${project.data.status} · ${project.data.themes.slice(0, 3).join(' · ')}`}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
